{
  "name": "Minimal UI",
  "version": "1.0.0",
  "cssVariables": {
    "--uc-bg": "#f7f7f5",
    "--uc-surface": "#ffffff",
    "--uc-soft": "#eeefeb",
    "--uc-ink": "#20221f",
    "--uc-muted": "#60655d",
    "--uc-line": "#d9ddd4",
    "--uc-accent": "#244c36",
    "--uc-on-accent": "#ffffff",
    "--uc-danger": "#a32932",
    "--uc-radius": "14px",
    "--uc-border": "1px",
    "--uc-shadow": "none",
    "--uc-fast": "140ms",
    "--uc-enter": "260ms",
    "--uc-exit": "160ms",
    "--uc-ease": "cubic-bezier(.2,.75,.25,1)",
    "--uc-distance": "12px",
    "--uc-shared": "300ms"
  },
  "dark": {
    "bg": "#161817",
    "surface": "#222522",
    "soft": "#30342f",
    "ink": "#f1f3ed",
    "muted": "#b8c0b3",
    "line": "#444b40",
    "accent": "#b9d8a7",
    "on-accent": "#193020",
    "danger": "#ffb4ab"
  },
  "motion": {
    "purpose": "连续，而不喧哗",
    "rules": [
      "入场：12px → 0，260ms，柔和减速。",
      "选择：底色或轮廓变化，140ms，不移动周围版式。",
      "共享表面：同一预览由局部展开为宽幅，300ms。"
    ],
    "reduced": "System reduce OR local reduced; cancel running animations",
    "interruption": "Latest animation on an element replaces previous one",
    "enterDistance": 12,
    "sharedMs": 300
  },
  "source": "https://www.apple.com/airpods-pro/"
}
