{
  "name": "Raster UI",
  "version": "0.4.0",
  "status": "provisional",
  "source": "raster-ui.css :root",
  "cssVariables": {
    "--rg-canvas": "#dce2d5",
    "--rg-surface": "#f2f4ed",
    "--rg-surface-raised": "#f7f9f2",
    "--rg-ink": "#203227",
    "--rg-muted": "#657166",
    "--rg-muted-canvas": "#59655a",
    "--rg-line": "#b7c2b1",
    "--rg-control-line": "#75846e",
    "--rg-subtle": "#e8ede1",
    "--rg-selected": "#d8e1cc",
    "--rg-accent": "#4d7043",
    "--rg-hover": "#38543b",
    "--rg-danger": "#96452f",
    "--rg-danger-bg": "#f6ebe5",
    "--rg-warning": "#785e1e",
    "--rg-warning-bg": "#f4efdd",
    "--rg-font": "\"Microsoft YaHei UI\",\"Microsoft YaHei\",\"PingFang SC\",system-ui,sans-serif",
    "--rg-mono": "\"Cascadia Mono\",Consolas,monospace",
    "--rg-space-1": "4px",
    "--rg-space-2": "8px",
    "--rg-space-3": "12px",
    "--rg-space-4": "16px",
    "--rg-space-5": "24px",
    "--rg-space-6": "32px",
    "--rg-space-7": "48px",
    "--rg-control-sm": "40px",
    "--rg-control-md": "48px",
    "--rg-control-lg": "56px",
    "--rg-touch-min": "44px",
    "--rg-control-pad-y": "var(--rg-space-3)",
    "--rg-control-pad-x": "calc(var(--rg-space-4) + var(--rg-space-1))",
    "--rg-content-gap": "var(--rg-space-4)",
    "--rg-panel-padding": "var(--rg-space-5)",
    "--rg-card-padding": "var(--rg-space-5)",
    "--rg-row-padding": "calc(var(--rg-space-4) + var(--rg-space-1))",
    "--rg-border": "1px",
    "--rg-border-strong": "3px",
    "--rg-motion": "120ms",
    "--rg-motion-press": "80ms",
    "--rg-motion-select": "160ms",
    "--rg-motion-enter": "200ms",
    "--rg-motion-exit": "120ms",
    "--rg-motion-confirm": "240ms",
    "--rg-motion-step": "4px",
    "--rg-cut": "polygon(0 8px,4px 8px,4px 4px,8px 4px,8px 0,calc(100% - 8px) 0,calc(100% - 8px) 4px,calc(100% - 4px) 4px,calc(100% - 4px) 8px,100% 8px,100% calc(100% - 8px),calc(100% - 4px) calc(100% - 8px),calc(100% - 4px) calc(100% - 4px),calc(100% - 8px) calc(100% - 4px),calc(100% - 8px) 100%,8px 100%,8px calc(100% - 4px),4px calc(100% - 4px),4px calc(100% - 8px),0 calc(100% - 8px))",
    "--rg-notch": "polygon(0 0,calc(100% - 16px) 0,calc(100% - 16px) 4px,calc(100% - 12px) 4px,calc(100% - 12px) 8px,calc(100% - 8px) 8px,calc(100% - 8px) 12px,calc(100% - 4px) 12px,calc(100% - 4px) 16px,100% 16px,100% 100%,0 100%)"
  },
  "rules": {
    "iconGrid": 24,
    "iconSizes": [
      24,
      48,
      72
    ],
    "cornerStep": 4,
    "borders": [
      1,
      3
    ],
    "spacing": [
      4,
      8,
      12,
      16,
      24,
      32,
      48
    ],
    "typography": {
      "body": 16,
      "label": 14,
      "metadata": 12,
      "heading": [
        22,
        24,
        28,
        36
      ]
    },
    "controlHeights": {
      "small": 40,
      "default": 48,
      "large": 56,
      "touchMinimum": 44
    },
    "breakpoints": {
      "cardList": 640
    },
    "scope": "Web CSS and DOM components; native app and mini-program adapters are not included.",
    "motion": {
      "easing": "steps; no spring or blur",
      "pressDistance": 2,
      "gridStep": 4,
      "enterDistance": 12,
      "exitDistance": 8,
      "staggerMs": 24,
      "maxStaggerMs": 96,
      "maxAnimatedChildren": 12,
      "reduced": "User reduced OR system prefers-reduced-motion; cancel running animations",
      "interruption": "The latest animation on an element replaces the previous one"
    },
    "particles": {
      "sizesPx": [
        2,
        4,
        6
      ],
      "positionSnapPx": 2,
      "durationsMs": {
        "burst": 720,
        "assemble": 820,
        "transfer": 880
      },
      "density": {
        "balanced": {
          "desktop": 24,
          "mobile": 16
        },
        "soft": {
          "desktop": 14,
          "mobile": 10
        },
        "transferRatio": 0.6
      },
      "maximumConcurrentFields": 2,
      "maximumDevicePixelRatio": 2,
      "idleRendering": false
    },
    "density": {
      "default": "comfortable",
      "compactSelector": "[data-rg-density=\"compact\"] or .rg-density-compact",
      "inherited": true,
      "comfortable": {
        "controlSmall": 40,
        "controlDefault": 48,
        "controlLarge": 56,
        "panelPadding": 24,
        "cardPadding": 24,
        "rowPadding": 20,
        "contentGap": 16
      },
      "compact": {
        "controlSmall": 36,
        "controlDefault": 40,
        "controlLarge": 48,
        "panelPadding": 16,
        "cardPadding": 16,
        "rowPadding": 12,
        "contentGap": 12
      },
      "coarsePointerMinimum": 44,
      "fontSizes": "unchanged by density"
    },
    "hierarchy": {
      "ordinaryContent": "light 1px separators",
      "selected": "control-line border and small 4px accent marker",
      "primaryAction": "ink fill with stepped corners",
      "secondaryAction": "quiet rectangular outline"
    },
    "contrast": {
      "mutedOnSurface": {
        "foreground": "--rg-muted",
        "background": "--rg-surface",
        "minimumRatio": 4.5
      },
      "mutedOnCanvas": {
        "foreground": "--rg-muted-canvas",
        "background": "--rg-canvas",
        "minimumRatio": 4.5
      },
      "usage": "Use --rg-muted-canvas for secondary text on canvas, subtle, or selected backgrounds; retain --rg-muted on pale surfaces."
    }
  }
}
