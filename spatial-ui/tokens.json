{
  "name": "Spatial UI",
  "version": "1.0.0",
  "cssVariables": {
    "--uc-bg": "#f0f1f6",
    "--uc-surface": "#ffffff",
    "--uc-soft": "#e4e7f0",
    "--uc-ink": "#1b2032",
    "--uc-muted": "#5e667e",
    "--uc-line": "#bdc3d2",
    "--uc-accent": "#384dba",
    "--uc-on-accent": "#ffffff",
    "--uc-danger": "#a52b46",
    "--uc-radius": "18px",
    "--uc-border": "1px",
    "--uc-shadow": "0 10px 30px #05071418",
    "--uc-fast": "180ms",
    "--uc-enter": "420ms",
    "--uc-exit": "220ms",
    "--uc-ease": "cubic-bezier(.16,1,.3,1)",
    "--uc-distance": "24px",
    "--uc-shared": "420ms"
  },
  "dark": {
    "bg": "#12151e",
    "surface": "#1c2130",
    "soft": "#272e40",
    "ink": "#f1f4ff",
    "muted": "#b1bbd0",
    "line": "#404b65",
    "accent": "#b9e75a",
    "on-accent": "#1d2a07",
    "danger": "#ffb6c8"
  },
  "motion": {
    "purpose": "把探索交给用户",
    "rules": [
      "入场：24px → 0，420ms，场景和说明分层。",
      "空间交互：局部±10°倾斜，文本保持平面。",
      "滚动驱动：深度与转角映射0–100%，可逆、可停留。"
    ],
    "reduced": "System reduce OR local reduced; cancel running animations",
    "interruption": "Latest animation on an element replaces previous one",
    "enterDistance": 24,
    "sharedMs": 420
  },
  "source": "https://www.thenerodesign.com/project/lusion"
}
