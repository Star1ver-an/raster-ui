{
  "name": "Brutal UI",
  "version": "1.0.0",
  "cssVariables": {
    "--uc-bg": "#f7f2e8",
    "--uc-surface": "#fffdf7",
    "--uc-soft": "#efe4ce",
    "--uc-ink": "#22211e",
    "--uc-muted": "#625c50",
    "--uc-line": "#22211e",
    "--uc-accent": "#e99bd2",
    "--uc-on-accent": "#22211e",
    "--uc-danger": "#a72530",
    "--uc-radius": "3px",
    "--uc-border": "2px",
    "--uc-shadow": "5px 5px 0 var(--uc-ink)",
    "--uc-fast": "100ms",
    "--uc-enter": "200ms",
    "--uc-exit": "120ms",
    "--uc-ease": "cubic-bezier(.15,.85,.25,1)",
    "--uc-distance": "12px",
    "--uc-shared": "200ms"
  },
  "dark": {
    "bg": "#191919",
    "surface": "#262626",
    "soft": "#38342c",
    "ink": "#f5efdf",
    "muted": "#c7bfad",
    "line": "#f5efdf",
    "accent": "#eaa1d3",
    "on-accent": "#241a22",
    "danger": "#ffb3aa"
  },
  "motion": {
    "purpose": "按下，就有回应",
    "rules": [
      "按压：4px下沉，投影收回，100ms。",
      "入场：12px → 0，200ms；展示区使用剪切揭示。",
      "确认：边界短暂强调，状态先更新，无庆祝等待。"
    ],
    "reduced": "System reduce OR local reduced; cancel running animations",
    "interruption": "Latest animation on an element replaces previous one",
    "enterDistance": 12,
    "sharedMs": 200
  },
  "source": "https://gumroad.com/"
}
