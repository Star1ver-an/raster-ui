{
  "name": "Expressive UI",
  "version": "1.0.0",
  "cssVariables": {
    "--uc-bg": "#faf7ff",
    "--uc-surface": "#ffffff",
    "--uc-soft": "#eee6f7",
    "--uc-ink": "#261d36",
    "--uc-muted": "#685b78",
    "--uc-line": "#d7cbe5",
    "--uc-accent": "#65508d",
    "--uc-on-accent": "#ffffff",
    "--uc-danger": "#a3293e",
    "--uc-radius": "26px",
    "--uc-border": "1px",
    "--uc-shadow": "0 4px 12px #30224a09",
    "--uc-fast": "180ms",
    "--uc-enter": "320ms",
    "--uc-exit": "180ms",
    "--uc-ease": "cubic-bezier(.2,.9,.2,1)",
    "--uc-distance": "18px",
    "--uc-shared": "360ms"
  },
  "dark": {
    "bg": "#19131f",
    "surface": "#261f30",
    "soft": "#352b41",
    "ink": "#f2eafa",
    "muted": "#c9bbd6",
    "line": "#51445f",
    "accent": "#d1b7f6",
    "on-accent": "#352047",
    "danger": "#ffb2c0"
  },
  "motion": {
    "purpose": "状态之间，有关系",
    "rules": [
      "按压：0.94 → 1，180ms，局部形状回应。",
      "组入场：18px → 0，320ms，组内间隔36ms。",
      "选择反馈：圆角与缩放共同变化，180ms。"
    ],
    "reduced": "System reduce OR local reduced; cancel running animations",
    "interruption": "Latest animation on an element replaces previous one",
    "enterDistance": 18,
    "sharedMs": 360
  },
  "source": "https://design.google/library/expressive-material-design-google-research"
}
