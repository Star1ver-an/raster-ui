{
  "name": "Liquid UI",
  "version": "1.0.0",
  "cssVariables": {
    "--uc-bg": "#eaf1f6",
    "--uc-surface": "#ffffffc9",
    "--uc-soft": "#dde8f0",
    "--uc-ink": "#183247",
    "--uc-muted": "#4c6579",
    "--uc-line": "#a6bccb",
    "--uc-accent": "#235b80",
    "--uc-on-accent": "#ffffff",
    "--uc-danger": "#9f3546",
    "--uc-radius": "24px",
    "--uc-border": "1px",
    "--uc-shadow": "0 12px 32px #253a5812,inset 0 1px 0 #ffffffbb",
    "--uc-fast": "170ms",
    "--uc-enter": "300ms",
    "--uc-exit": "190ms",
    "--uc-ease": "cubic-bezier(.22,.8,.24,1)",
    "--uc-distance": "8px",
    "--uc-shared": "360ms"
  },
  "dark": {
    "bg": "#142739",
    "surface": "#223c50e8",
    "soft": "#29475e",
    "ink": "#edf6ff",
    "muted": "#bdcfdf",
    "line": "#54728a",
    "accent": "#a7d7fa",
    "on-accent": "#15354b",
    "danger": "#ffbdca"
  },
  "motion": {
    "purpose": "同一块表面的延续",
    "rules": [
      "面板入场：8px → 0，300ms，边缘光随表面就位。",
      "共享表面：展开保持对象连续，360ms。",
      "滚动揭示：裁剪从12%收束到0，反向滚动可回退。"
    ],
    "reduced": "System reduce OR local reduced; cancel running animations",
    "interruption": "Latest animation on an element replaces previous one",
    "enterDistance": 8,
    "sharedMs": 360
  },
  "source": "https://www.apple.com/newsroom/2025/06/apple-introduces-a-delightful-and-elegant-new-software-design/"
}
